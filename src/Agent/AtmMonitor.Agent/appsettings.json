{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "Agent": {
    "ServerUrl": "https://atm-monitor.example.local",
    "TerminalId": "",
    "EnrollmentToken": "",
    "DataDirectory": "data",
    "StatusIntervalSeconds": 30,
    "LogShipIntervalSeconds": 10,
    "MaxOutboxItems": 50000,
    "AllowInsecureTransport": false,
    "DeviceProvider": "Simulator",
    "AllowReboot": false,
    "HostCheck": {
      "Host": "",
      "Port": 0,
      "Samples": 4,
      "TimeoutMs": 2000,
      "InterfaceName": ""
    },
    "LogSources": [],
    "Scripts": {},
    "ApplicationControl": {
      "RestartFileName": "",
      "RestartArguments": []
    }
  }
}
