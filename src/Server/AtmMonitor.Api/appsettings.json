{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore.SignalR": "Warning",
        "Microsoft.AspNetCore.Http.Connections": "Warning",
        "Microsoft.AspNetCore.DataProtection": "Error"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Database": {
    "Provider": "Postgres",
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "atm-monitor",
    "Audience": "atm-monitor",
    "SigningKey": "",
    "AccessTokenMinutes": 480
  },
  "Bootstrap": {
    "AdminPassword": "",
    "EnrollmentToken": ""
  },
  "Monitoring": {
    "OfflineAfterSeconds": 120,
    "WatchdogIntervalSeconds": 15,
    "TelemetrySampleSeconds": 60,
    "MaxLogEntriesPerBatch": 500
  },
  "Alerts": {
    "DiskUsedWarningPercent": 90,
    "PacketLossWarningPercent": 20,
    "LatencyWarningMs": 500
  },
  "Retention": {
    "TelemetryDays": 30,
    "LogDays": 90,
    "ResolvedAlertDays": 180,
    "CommandDays": 180,
    "AuditDays": 2555,
    "RunEveryHours": 6
  },
  "RateLimits": {
    "LoginPerMinute": 10,
    "EnrollPerMinute": 30
  },
  "BackgroundJobs": {
    "Enabled": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  }
}
