<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Company>AtmMonitor</Company>
    <Product>ATM Fleet Monitor</Product>
    <Version>1.0.0</Version>
    <!-- CA1862: EF Core translates ToLower().Contains() to SQL; the StringComparison overloads do not translate.
         CA1848/CA1873: LoggerMessage source generators are preferred on hot paths but not mandated everywhere.
         CA2007: ConfigureAwait is irrelevant in ASP.NET Core / generic host apps (no SynchronizationContext). -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2007;CA1716;CA1711;CA1819;CA1002;CA2227;CA1056;CA1054;CA1062;CA1515;CA1031;CA1822;CA1861;CA5394;CA1308;CA1305;CA1304;CA1311;CA1310;CA1307;CA1309;CA1863;CA1725;CA1862</NoWarn>
  </PropertyGroup>
</Project>
